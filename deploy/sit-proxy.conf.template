# SIT ingress only. Traefik's TaskDesk routers allow only current Cloudflare socket peers.
# Trust the exact resolved Traefik container, never the shared Docker subnet.
# A changed/untrusted peer fails closed until this sidecar is reloaded/recreated.
resolver 127.0.0.11 valid=10s ipv6=off;
resolver_timeout 5s;
upstream taskdesk_sit_runtime {
    zone taskdesk_sit_runtime 64k;
    server taskdesk:${TASKDESK_PORT} resolve;
}
map $http_upgrade $taskdesk_connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 8080 default_server;
    server_name _;
    location = /healthz {
        proxy_set_header Host tickting.technexus.info;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://taskdesk_sit_runtime/api/public/health/ready;
    }
    location / { return 444; }
}
server {
    listen 8080;
    server_name tickting.technexus.info portal.technexus.info;
    set_real_ip_from ${TASKDESK_SIT_TRAEFIK_HOST};
    real_ip_header CF-Connecting-IP;
    real_ip_recursive off;
    client_max_body_size 0;
    location = /healthz {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://taskdesk_sit_runtime/api/public/health/ready;
    }
    location / {
        # Includes missing/malformed Cloudflare headers and stale trusted-peer DNS.
        if ($remote_addr = $realip_remote_addr) { return 400; }
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header X-Real-IP "";
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header X-Taskdesk-Client-IP "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $taskdesk_connection_upgrade;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_pass http://taskdesk_sit_runtime;
    }
}
