{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"rootDir": "../..",
		"jsx": "react-jsx",
		"paths": {
			"@taskdesk/permissions": [
				"../../packages/permissions/src/index.ts"
			],
			"@taskdesk/domain": [
				"../../packages/domain/src/index.ts"
			],
			"vitest": [
				"./node_modules/vitest"
			],
			"hono": [
				"./node_modules/hono"
			],
			"hono/*": [
				"./node_modules/hono/dist/types/*"
			],
			"drizzle-orm": [
				"./node_modules/drizzle-orm"
			],
			"drizzle-orm/*": [
				"./node_modules/drizzle-orm/*"
			],
			"pg": [
				"./node_modules/@types/pg"
			],
			"@testcontainers/postgresql": [
				"./node_modules/@testcontainers/postgresql"
			],
			"better-auth/types": [
				"./node_modules/better-auth/dist/types/index.d.mts"
			]
		}
	},
	"include": [
		"scripts/seed-profile.ts",
		"scripts/seed-cli.ts",
		"scripts/seed-cli.test.ts",
		"scripts/seed-postgres.test.ts",
		"scripts/seed-test-users.test.ts",
		"../../tests/api/seed-test-global-setup.ts",
		"../../tests/api/seed-test-setup.ts",
		"vitest.seed.config.ts",
		"../../tests/api/**/*.ts",
		"../../tests/api-integration/**/*.ts",
		"../../tests/e2e/helpers/mfa-csrf-app-fixture.ts"
	]
}
