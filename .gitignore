# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
.yarn/

# ── Build output ────────────────────────────────────────────────────────────
dist/
build/
out/
.next/                 # apps/site (Next.js + Fumadocs)
storybook-static/
*.tsbuildinfo
.turbo/
.vite/
.cache/
.rollup.cache/

# ── Test artefacts ──────────────────────────────────────────────────────────
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
playwright/.cache/
tests/visual/**/*-actual.png
tests/visual/**/*-diff.png
k6-results/

# ── Environment and secrets — never commit; deploy/.env.example is the template
.env
.env.*
!.env.example
!deploy/.env.example
*.pem
*.key
*.crt
!tests/fixtures/**/*.pem
deploy/local/certs/
deploy/local/data/
*.sqlite
*.sqlite3

# ── Generated at build/release time, not source ─────────────────────────────
sbom*.json
sbom*.xml
apps/site/public/openapi.json
.sentryclirc

# ── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/
pnpm-debug.log*
npm-debug.log*
yarn-error.log*
lerna-debug.log*

# ── Editors and OS ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.history/

# ── Local tooling state ─────────────────────────────────────────────────────
.eslintcache
.biome-cache/
tmp/
temp/
*.local
