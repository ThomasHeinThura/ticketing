{
  "name": "taskdesk",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "i18n:check": "node ./scripts/i18n/check.mjs",
    "i18n:check:fix": "node ./scripts/i18n/check.mjs --fix",
    "i18n:report": "node ./scripts/i18n/report.mjs",
    "i18n:report:fix": "node ./scripts/i18n/report.mjs --fix",
    "i18n:schema": "node ./scripts/i18n/schema.mjs && biome format --write i18n/schema.json",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:coverage": "pnpm --filter @taskdesk/domain test:coverage",
    "test:contract": "node ./scripts/ci/test-contract.mjs",
    "test:seed": "pnpm --filter @taskdesk/api exec vitest run --config vitest.seed.config.ts",
    "test:e2e": "pnpm --filter @taskdesk/web test:e2e",
    "test:visual": "pnpm check:visual-scope && pnpm --filter @taskdesk/web test:visual",
    "test:perf": "pnpm --filter @taskdesk/web test:perf",
    "test:a11y": "pnpm --filter @taskdesk/ui exec vitest run --config vitest.config.ts src/components/stories.accessibility.test.tsx && pnpm --filter @taskdesk/web exec playwright test --config playwright.config.ts --grep @a11y",
    "test:integration": "turbo test:integration",
    "test:no-inherited-routes": "pnpm test:permissions -- no-inherited-integration-routes.test.ts",
    "test:permissions": "turbo test:permissions",
    "typecheck": "turbo typecheck",
    "prepare": "husky",
    "seed": "pnpm --filter @taskdesk/api exec tsx ../../scripts/seed.ts",
    "check:dockerfile-deps": "node ./scripts/ci/check-dockerfile-deps.mjs",
    "check:bundle-size": "node ./scripts/ci/check-bundle-size.mjs",
    "check:bundle-purity": "node ./scripts/ci/check-bundle-purity.mjs",
    "check:deps": "node ./scripts/ci/check-deps.mjs",
    "check:env": "node ./scripts/ci/check-env.mjs",
    "check:events": "node ./scripts/ci/check-events.mjs",
    "check:inventory": "node ./scripts/ci/check-inventory.mjs",
    "generate:route-metadata": "node ./scripts/ci/generate-route-metadata.mjs",
    "check:i18n": "node ./scripts/i18n/check.mjs",
    "check:openapi": "node ./scripts/ci/check-openapi.mjs",
    "check:queries": "node ./scripts/ci/check-queries.mjs",
    "check:overrides": "node ./scripts/ci/check-overrides.mjs",
    "check:pr-template": "node ./scripts/ci/check-pr-template.mjs",
    "check:reviews": "node ./scripts/ci/check-reviews.mjs",
    "check:route-policy": "node ./scripts/ci/route-policy-gate.mjs",
    "check:skips": "node ./scripts/ci/check-skips.mjs",
    "check:tokens": "node ./scripts/ci/check-tokens.mjs && node ./scripts/ci/check-contrast.mjs",
    "check:ui": "node ./scripts/ci/check-ui.mjs",
    "check:vocabulary": "node ./scripts/ci/check-vocabulary.mjs",
    "check:visual-scope": "node ./scripts/ci/check-visual-scope.mjs",
    "lint:ci": "biome ci .",
    "openapi:write": "node ./scripts/ci/check-openapi.mjs --write",
    "test:all": "node ./scripts/ci/test-all.mjs",
    "test:ci-scripts": "node --test 'scripts/ci/**/*.test.mjs'"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@redocly/cli": "2.54.2",
    "esbuild": "0.28.1",
    "husky": "^9.1.7",
    "linkifyjs": ">=4.3.3",
    "tar-fs": ">=3.1.3",
    "turbo": "^2.10.8",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "version": "2.22.0",
  "dependencies": {
    "dotenv-mono": "^1.5.1"
  }
}
