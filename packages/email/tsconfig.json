{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "noEmit": false,
    "outDir": "${configDir}/dist",
    "rootDir": "${configDir}/src",
    "jsx": "react",
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,

    // NO "incremental" / "tsBuildInfoFile" here, deliberately.
    //
    // This package used `incremental: true` with the build-info file parked OUTSIDE
    // outDir at ${configDir}/.cache/tsbuildinfo.json. Delete dist/ without also
    // deleting .cache/ — which is what every clean/cold-build convention in this
    // repository does, since every sibling package keeps its state in dist/ alone —
    // and `tsc` trusts the stale cache, concludes there is nothing to emit, writes
    // ZERO files and exits 0. Reproduced: `rm -rf dist && pnpm build` left no dist at
    // all, and apps/api then failed with `Failed to resolve entry for package
    // "@taskdesk/email"`.
    //
    // A build whose exit code is not evidence that it produced anything is the same
    // defect class as issue #59, where `pnpm build` exited 0 and the artifact could
    // not boot. So this is removed rather than relocated: measured on this package —
    // 17 files, 1092 lines — cold is 0.41s and warm 0.35s, so incrementality saved
    // ~50ms and cost a silent-empty-output failure mode. packages/permissions,
    // packages/mcp and packages/libs all use plain dist/ with no separate cache; this
    // now matches them.
    "disableSourceOfProjectReferenceRedirect": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "checkJs": true,

    "noImplicitAny": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
