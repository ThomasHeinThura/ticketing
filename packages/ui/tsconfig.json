{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "../typescript-config/react-library.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./src",
		"noEmit": true,
		"module": "ESNext",
		"moduleResolution": "bundler"
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
