	},
	"devDependencies": {
		"@taskdesk/typescript-config": "workspace:*",
		"@vitest/coverage-v8": "^4.1.10",
		"typescript": "^7.0.2",
		"vite": "^8.2.0",
		"vitest": "^4.1.10"
	}
