{
	"name": "@taskdesk/domain",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"license": "MIT",
	"scripts": {
		"build": "tsc",
		"lint": "biome check --write .",
		"typecheck": "tsc --noEmit -p tsconfig.json",
